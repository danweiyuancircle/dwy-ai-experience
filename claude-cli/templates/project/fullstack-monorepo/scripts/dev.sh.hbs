#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
BACKEND_PORT={{portPrefix}}8001
FRONTEND_PORT={{portPrefix}}5173
BACKEND_PID=""
FRONTEND_PID=""

# ── 清理函数 ──

cleanup() {
  echo ""
  echo "正在关闭服务..."
  [ -n "$FRONTEND_PID" ] && kill "$FRONTEND_PID" 2>/dev/null
  [ -n "$BACKEND_PID" ] && kill "$BACKEND_PID" 2>/dev/null
  wait 2>/dev/null
  echo "已关闭前后端进程。Docker 基础设施保持运行。"
}
trap cleanup EXIT

kill_port() {
  local port=$1
  local pids
  pids=$(lsof -ti:"$port" 2>/dev/null || true)
  if [ -n "$pids" ]; then
    echo "  端口 $port 被占用 (PID: $pids)，正在释放..."
    echo "$pids" | xargs kill -9 2>/dev/null || true
    sleep 0.5
  fi
}

# ── 1. 释放被占用的端口 ──

echo "▶ 检查端口占用..."
kill_port $BACKEND_PORT
kill_port $FRONTEND_PORT

# ── 2. 启动 Docker 基础设施 ──

echo "▶ 启动 Docker 基础设施..."
docker compose -f "$SCRIPT_DIR/docker-compose.dev.yml" up -d --remove-orphans

echo "▶ 等待 PostgreSQL 就绪..."
until docker compose -f "$SCRIPT_DIR/docker-compose.dev.yml" exec -T db pg_isready -U postgres > /dev/null 2>&1; do
  sleep 1
done

echo "▶ 等待 Redis 就绪..."
until docker compose -f "$SCRIPT_DIR/docker-compose.dev.yml" exec -T redis redis-cli ping > /dev/null 2>&1; do
  sleep 1
done

echo ""
echo "✔ 基础设施就绪"
echo "  PostgreSQL  → 127.0.0.1:{{portPrefix}}5432"
echo "  Redis       → 127.0.0.1:{{portPrefix}}6379"
echo ""

# ── 3. 启动后端 ──

echo "▶ 启动后端 (port $BACKEND_PORT)..."
cd "$SCRIPT_DIR/backend"
uv run uvicorn app.main:app --reload --port $BACKEND_PORT &
BACKEND_PID=$!

# ── 4. 启动前端 ──

echo "▶ 启动前端 (port $FRONTEND_PORT)..."
cd "$SCRIPT_DIR/frontend"
pnpm dev &
FRONTEND_PID=$!

echo ""
echo "════════════════════════════════════════"
echo "  {{projectName}} 开发环境已启动"
echo "  前端: http://localhost:$FRONTEND_PORT"
echo "  后端: http://localhost:$BACKEND_PORT"
echo "  按 Ctrl+C 关闭前后端"
echo "════════════════════════════════════════"
echo ""

wait
