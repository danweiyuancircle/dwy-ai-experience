# ============================================================
# {{projectName}} — 环境变量样例
# ============================================================
# 复制为 .env 并填入真实值。.env 已 gitignored。
# 端口前缀策略：本项目用 {{portPrefix}}xxxx 万位前缀避免与其他项目冲突。

# ── 基础 ──
ENVIRONMENT=dev
SECRET_KEY=change-me-in-production

# ── PostgreSQL ──
# docker-compose.dev.yml 默认本地端口：127.0.0.1:{{portPrefix}}5432
POSTGRES_DB={{projectName}}
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:{{portPrefix}}5432/{{projectName}}

# ── Redis ──
# docker-compose.dev.yml 默认本地端口：127.0.0.1:{{portPrefix}}6379
REDIS_URL=redis://127.0.0.1:{{portPrefix}}6379/0

# ── 服务端口（dev.sh 读取） ──
BACKEND_PORT={{portPrefix}}8001
FRONTEND_PORT={{portPrefix}}5173
