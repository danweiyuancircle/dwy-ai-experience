services:
  db:
    image: postgres:16-alpine
    ports:
      - "127.0.0.1:{{devDbPort}}:5432"
    environment:
      POSTGRES_USER: dev
      POSTGRES_PASSWORD: dev123
      POSTGRES_DB: {{dbName}}
    volumes:
      - pgdata:/var/lib/postgresql/data

  redis:
    image: redis:7-alpine
    ports:
      - "127.0.0.1:{{devRedisPort}}:6379"

volumes:
  pgdata:
