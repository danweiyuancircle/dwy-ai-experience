#!/bin/bash
set -euo pipefail

PROJECT_NAME="{{projectName}}"
SSH_ALIAS="{{sshAlias}}"
REMOTE_DIR="/opt/{{projectName}}"
BACKEND_PORT={{backendPort}}
HEALTH_CHECK_PATH="/api/health"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log()  { echo -e "${GREEN}[DEPLOY]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
err()  { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }

push_code() {
    log "推送代码到 Gitee..."
    git push origin master || err "git push 失败"
}

pull_remote() {
    log "远程拉取代码..."
    ssh $SSH_ALIAS "cd $REMOTE_DIR && git pull origin master" || err "远程 git pull 失败"
}

build_frontend() {
    log "构建前端..."
    cd frontend && pnpm build || err "前端构建失败"
    cd ..
}

upload_frontend() {
    log "上传前端构建产物..."
    tar czf /tmp/frontend-dist.tar.gz -C frontend dist/
    scp /tmp/frontend-dist.tar.gz $SSH_ALIAS:$REMOTE_DIR/ || err "上传失败"
    ssh $SSH_ALIAS "cd $REMOTE_DIR && mkdir -p frontend && tar xzf frontend-dist.tar.gz -C frontend/ && rm frontend-dist.tar.gz"
    rm /tmp/frontend-dist.tar.gz
}

run_migrations() {
    log "执行数据库迁移..."
    ssh $SSH_ALIAS "cd $REMOTE_DIR && docker compose -f docker-compose.prod.yml run --rm backend alembic upgrade head" || err "迁移失败"
}

restart_backend() {
    log "重建后端容器..."
    ssh $SSH_ALIAS "cd $REMOTE_DIR && docker compose -f docker-compose.prod.yml up -d --build backend"
}

verify() {
    log "验证部署..."
    sleep 3

    HEALTH=$(ssh $SSH_ALIAS "curl -s http://localhost${HEALTH_CHECK_PATH}" 2>/dev/null)
    if echo "$HEALTH" | grep -q '"ok"'; then
        log "API 健康检查: ✅"
    else
        err "API 健康检查失败: $HEALTH"
    fi

    GIT_CODE=$(ssh $SSH_ALIAS "curl -s -o /dev/null -w '%{http_code}' http://localhost/.git/config" 2>/dev/null)
    ENV_CODE=$(ssh $SSH_ALIAS "curl -s -o /dev/null -w '%{http_code}' http://localhost/.env" 2>/dev/null)
    if [ "$GIT_CODE" = "404" ] && [ "$ENV_CODE" = "404" ]; then
        log "安全检查: ✅ (.git/.env 已屏蔽)"
    else
        warn "安全检查: .git=$GIT_CODE .env=$ENV_CODE"
    fi

    log "部署完成!"
}

case "${1:-all}" in
    --backend)
        log "=== 仅部署后端 ==="
        push_code
        pull_remote
        run_migrations
        restart_backend
        verify
        ;;
    --frontend)
        log "=== 仅部署前端 ==="
        build_frontend
        upload_frontend
        verify
        ;;
    --restart)
        log "=== 仅重启容器 ==="
        ssh $SSH_ALIAS "cd $REMOTE_DIR && docker compose -f docker-compose.prod.yml up -d --force-recreate"
        verify
        ;;
    --check)
        log "=== 安全检查 ==="
        verify
        ;;
    all|"")
        log "=== 全量部署 ==="
        push_code
        pull_remote
        build_frontend
        upload_frontend
        run_migrations
        restart_backend
        verify
        ;;
    *)
        echo "用法: ./deploy.sh [--backend|--frontend|--restart|--check]"
        exit 1
        ;;
esac
