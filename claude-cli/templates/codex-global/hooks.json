{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)\"/.codex/hooks/pre-git-commit-sensitive-check.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
