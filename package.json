{
  "name": "dwy-shared",
  "private": true,
  "scripts": {
    "build:eui": "pnpm -F @dwydev/eui build",
    "build:ekit": "pnpm -F @dwydev/ekit build",
    "build:cli": "echo 'cli has no build step'",
    "build:frontend": "pnpm -F @dwydev/eui build && pnpm -F @dwydev/ekit build",
    "test:eapi": "cd backend && pytest tests/ -v",
    "publish:eui": "pnpm -F @dwydev/eui publish --access public --no-git-checks",
    "publish:ekit": "pnpm -F @dwydev/ekit publish --access public --no-git-checks",
    "publish:cli": "cd claude-cli && npm publish --access public",
    "publish:eapi": "cd backend && uv build && uv publish",
    "changelog": "changelogen"
  },
  "devDependencies": {
    "changelogen": "^0.6.2"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
