{
  "name": "dwy-shared",
  "private": true,
  "scripts": {
    "build:eui": "pnpm -F @danweiyuan/eui build",
    "build:ekit": "pnpm -F @danweiyuan/ekit build",
    "build:cli": "echo 'cli has no build step'",
    "build:frontend": "pnpm -F @danweiyuan/eui build && pnpm -F @danweiyuan/ekit build",
    "test:eapi": "cd backend && pytest tests/ -v",
    "publish:eui": "pnpm -F @danweiyuan/eui publish --access public --no-git-checks",
    "publish:ekit": "pnpm -F @danweiyuan/ekit publish --access public --no-git-checks",
    "publish:cli": "cd claude-cli && npm publish --access public",
    "publish:eapi": "cd backend && uv build && uv publish",
    "changelog": "changelogen"
  },
  "devDependencies": {
    "changelogen": "^0.6.2"
  }
}
