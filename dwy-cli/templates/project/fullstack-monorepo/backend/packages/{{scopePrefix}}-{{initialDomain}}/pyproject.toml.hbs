[project]
name = "{{scopePrefix}}-{{initialDomain}}"
version = "0.1.0"
description = "{{initialDomain}} 业务包"
requires-python = ">=3.11"
# 依赖仅声明包名,版本号由根 pyproject.toml 统一管理
dependencies = [
    "fastapi",
    "sqlalchemy",
    "pydantic",
    "dwyeapi",
    "dwy-shared",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{scopePrefix}}_{{initialDomain}}"]
