# {{projectName}} 生产 compose -- 三服务（backend + db + redis）+ 资源限制 + 日志轮转
#
# 部署假设:
#   - 前端由宿主机全局 nginx 托管(静态文件在 /var/www/{{projectName}}/dist),
#     配置见 deploy/nginx/{{projectName}}.conf(用户自维护)。
#   - backend 仅绑定 127.0.0.1:{{portPrefix}}8002,由宿主 nginx 反代上游。
#   - 敏感凭据来自 backend/.env(env_file 引用),不要在 yml 硬编码。

x-logging: &default-logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "5"
    compress: "true"

services:
  backend:
    image: {{projectName}}-backend:${BACKEND_TAG:-prod}
    build:
      context: ./backend
      dockerfile: Dockerfile.prod
    ports:
      - "127.0.0.1:{{portPrefix}}8002:8000"
    env_file:
      - ./backend/.env
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "python -c 'import httpx; httpx.get(\"http://127.0.0.1:8000/api/health\")'"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s
    read_only: true
    tmpfs:
      - /tmp
    mem_limit: 1g
    logging: *default-logging
    restart: unless-stopped

  db:
    image: postgres:16.12-alpine3.23
    shm_size: 256m
    environment:
      TZ: Asia/Shanghai
      PGTZ: Asia/Shanghai
      POSTGRES_DB: {{projectName}}
      POSTGRES_USER: ${POSTGRES_USER:-app_user}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?POSTGRES_PASSWORD required}
    # 1G 容器: shared_buffers=25%, effective_cache_size=75%
    command:
      - "postgres"
      - "-c"
      - "timezone=Asia/Shanghai"
      - "-c"
      - "max_connections=100"
      - "-c"
      - "shared_buffers=256MB"
      - "-c"
      - "effective_cache_size=768MB"
      - "-c"
      - "work_mem=4MB"
      - "-c"
      - "maintenance_work_mem=64MB"
      - "-c"
      - "log_min_duration_statement=500"
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-app_user} -d {{projectName}}"]
      interval: 5s
      timeout: 3s
      retries: 5
    mem_limit: 1g
    logging:
      driver: json-file
      options:
        max-size: "20m"
        max-file: "10"
        compress: "true"
    # 生产环境不暴露端口
    restart: unless-stopped

  redis:
    image: redis:7.4.9-alpine3.21
    # maxmemory 256mb 是 Redis 进程自管上限;mem_limit 384m 给 RDB/AOF fork
    # 的 COW 留 buffer,避免被宿主 OOM-killer 杀掉。
    # AOF + RDB 双持久化:重启不丢业务数据(验证码/nonce/限流计数等)。
    command: [
      "redis-server",
      "--requirepass", "${REDIS_PASSWORD:?REDIS_PASSWORD required}",
      "--maxmemory", "256mb",
      "--maxmemory-policy", "allkeys-lru",
      "--appendonly", "yes",
      "--appendfsync", "everysec",
      "--save", "900 1",
      "--save", "300 10"
    ]
    volumes:
      - redisdata:/data
    healthcheck:
      test: ["CMD", "redis-cli", "-a", "${REDIS_PASSWORD}", "--no-auth-warning", "ping"]
      interval: 5s
      timeout: 3s
      retries: 5
    mem_limit: 384m
    logging: *default-logging
    # 生产环境不暴露端口
    restart: unless-stopped

volumes:
  pgdata:
  redisdata:
