{
  "name": "@dwydev/admin-kit",
  "version": "0.3.0",
  "type": "module",
  "description": "Vue 3 管理框架与通用组合组件：模块、菜单、路由、数据展示及分页状态；业务与认证由宿主注入",
  "license": "MIT",
  "author": "dwydev",
  "repository": {
    "type": "git",
    "url": "https://github.com/danweiyuancircle/dwy-ai-experience.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./composables": {
      "types": "./dist/composables/index.d.ts",
      "import": "./dist/composables/index.js"
    },
    "./paged-list": {
      "types": "./dist/paged-list/index.d.ts",
      "import": "./dist/paged-list/index.js"
    },
    "./status/tone": {
      "types": "./dist/components/status/tone.d.ts",
      "import": "./dist/components/status/tone.js"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": ["**/*.css"],
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "peerDependencies": {
    "@dwydev/ekit": "^0.9.0 || ^0.10.0",
    "@dwydev/eui": "^2.7.2",
    "lucide-vue-next": ">=0.400.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@dwydev/ekit": "workspace:*",
    "@dwydev/eui": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "lucide-vue-next": "^1.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^3.2.4",
    "vue": "^3.5.32",
    "vue-router": "^4.6.4"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:pack": "node scripts/smoke-pack.mjs"
  }
}
