{
  "name": "@dwydev/eui",
  "version": "2.3.0",
  "type": "module",
  "description": "Vue 3 component library — shadcn-vue visuals + Element Plus API + Tailwind CSS 4",
  "license": "MIT",
  "author": "dwydev",
  "repository": {
    "type": "git",
    "url": "https://github.com/danweiyuancircle/dwy-ai-experience.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./theme": "./src/theme/index.css",
    "./theme/tokens": "./src/theme/tokens.css",
    "./theme/dark": "./src/theme/dark.css"
  },
  "files": [
    "dist",
    "src/theme",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "peerDependencies": {
    "@vueuse/core": "^14.2.1",
    "lucide-vue-next": "^1.0.0",
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.0",
    "vue-sonner": "^2.0.0",
    "zod": "^3.25.0"
  },
  "dependencies": {
    "@floating-ui/vue": "^1.1.0",
    "@internationalized/date": "^3.12.0",
    "@tanstack/vue-table": "^8.21.0",
    "@vee-validate/zod": "^4.15.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-vue": "^8.6.0",
    "reka-ui": "^2.9.0",
    "tailwind-merge": "^3.0.0",
    "vee-validate": "^4.15.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.0",
    "@vueuse/core": "^14.2.1",
    "jsdom": "^26.0.0",
    "lucide-vue-next": "^1.0.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^3.0.0",
    "vue": "^3.5.32",
    "vue-sonner": "^2.0.0",
    "zod": "^3.25.0"
  },
  "scripts": {
    "build": "vite build && node scripts/gen-manifest.mjs",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen-manifest": "node scripts/gen-manifest.mjs"
  }
