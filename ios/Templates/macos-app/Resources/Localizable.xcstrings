    "settings_rate_footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system review prompt has a yearly limit. If it doesn’t appear, that’s expected. After listing, fill AppConfig.appStoreID so this button can open the App Store write-review page."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统评价框每年有次数上限，未弹出属正常。上架后把 AppConfig.appStoreID 填上，此按钮才会再打开 App Store 写评价页。"
          }
        }
      }
    },
